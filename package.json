{
  "name": "gemcommit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.13-d01",
  "author": "Freilyn Bernabé <freilyn@bernabe.dev>",
  "publisher": "bernabe",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernabedev/gemcommit"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "gemini",
    "conventional commits"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gemcommit.suggestCommitMessage",
        "title": "%command.suggestCommitMessage.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "gemcommit.detailedCommitMessage",
        "title": "%command.detailedCommitMessage.title%",
        "icon": "$(pencil)"
      },
      {
        "command": "gemcommit.showCommitHistory",
        "title": "%command.showCommitHistory.title%",
        "icon": "$(history)"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "gemcommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%",
          "deprecationMessage": "Storing the API key in settings is deprecated. Please use the GEMINI_API_KEY environment variable in your `~/.env` file instead for better security."
        },
        "gemcommit.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "%config.model.description%"
        },
        "gemcommit.customPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.customPrompt.description%"
        },
        "gemcommit.customPromptFile": {
          "type": "string",
          "default": ".gemcommit.md",
          "description": "%config.customPromptFile.description%"
        },
        "gemcommit.customDetailedPromptFile": {
          "type": "string",
          "default": ".gemcommit_detailed.md",
          "description": "%config.customDetailedPromptFile.description%"
        },
        "gemcommit.promptBeforeInsert": {
          "type": "boolean",
          "default": false,
          "description": "%config.promptBeforeInsert.description%"
        },
        "gemcommit.maxHistorySize": {
          "type": "number",
          "default": 20,
          "description": "%config.maxHistorySize.description%"
        },
        "gemcommit.includeProjectContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeProjectContext.description%"
        },
        "gemcommit.commitLanguage": {
          "type": "string",
          "description": "%config.commitLanguage.description%",
          "default": "english",
          "enum": [
            "english",
            "spanish",
            "french",
            "german",
            "italian",
            "portuguese"
          ],
          "enumDescriptions": [
            "%config.commitLanguage.enum.english%",
            "%config.commitLanguage.enum.spanish%",
            "%config.commitLanguage.enum.french%",
            "%config.commitLanguage.enum.german%",
            "%config.commitLanguage.enum.italian%",
            "%config.commitLanguage.enum.portuguese%"
          ]
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "gemcommit.suggestCommitMessage",
          "group": "navigation",
          "icon": "$(sparkle)"
        },
        {
          "command": "gemcommit.detailedCommitMessage",
          "group": "navigation",
          "icon": "$(pencil)"
        },
        {
          "command": "gemcommit.showCommitHistory",
          "group": "navigation",
          "icon": "$(history)"
        }
      ],
      "commandPalette": [
        {
          "command": "gemcommit.suggestCommitMessage"
        },
        {
          "command": "gemcommit.detailedCommitMessage"
        },
        {
          "command": "gemcommit.showCommitHistory"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish_pnpm": "pnpm run compile",
    "vscode:prepublish_npm": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch_npm": "node ./esbuild.mjs --watch",
    "bundle": "node ./esbuild.mjs",
    "pretest": "pnpm run compile && pnpm run lint",
    "pretest_npm": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.3.0",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.33.0",
    "fs-extra": "^11.3.1",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vscode/l10n": "^0.0.18",
    "dotenv": "^17.2.1"
  }
}
